# Shared lwIP configuration: Makefile.conf collects the options in
# LWIP_FLAGS, which are written to virtwip_config.h. Both the host glue and
# the VM image (pkg/virtwip/Makefile) include it via include_shared/lwipopts.h.
# The file is only rewritten when its content changes, so it does not trigger
# rebuilds on every make invocation.
include $(RIOTBASE)/pkg/virtwip/Makefile.conf

VIRTWIP_CONFIG_DIR := $(BINDIR)/virtwip_config
VIRTWIP_CONFIG_H := $(VIRTWIP_CONFIG_DIR)/virtwip_config.h

_VIRTWIP_HASH := \#
define _VIRTWIP_NL


endef
# -DNAME=VALUE -> NAME / VALUE (a bare -DNAME becomes 1, shell quotes dropped)
_virtwip_name = $(firstword $(subst =, ,$(1)))
_virtwip_value = $(if $(findstring =,$(1)),$(subst ',,$(patsubst $(call _virtwip_name,$(1))=%,%,$(1))),1)

_VIRTWIP_CONFIG := /* Generated by pkg/virtwip/Makefile.include - do not edit */
_VIRTWIP_CONFIG += $(_VIRTWIP_NL)$(_VIRTWIP_HASH)pragma once$(_VIRTWIP_NL)
_VIRTWIP_CONFIG += $(foreach f,$(patsubst -D%,%,$(LWIP_FLAGS)),$(_VIRTWIP_NL)$(_VIRTWIP_HASH)define $(call _virtwip_name,$(f)) $(call _virtwip_value,$(f)))

_VIRTWIP_SPACE := $(subst ,, )
# foreach joins with spaces: drop them again at the line ends
_VIRTWIP_CONFIG := $(subst $(_VIRTWIP_SPACE)$(_VIRTWIP_NL),$(_VIRTWIP_NL),$(_VIRTWIP_CONFIG))

ifneq ($(_VIRTWIP_CONFIG),$(file <$(VIRTWIP_CONFIG_H)))
  $(shell mkdir -p $(VIRTWIP_CONFIG_DIR))
  $(file >$(VIRTWIP_CONFIG_H),$(_VIRTWIP_CONFIG))
endif

INCLUDES += -I$(RIOTBASE)/pkg/virtwip/include \
            -I$(RIOTBASE)/pkg/virtwip/include_shared \
            -I$(VIRTWIP_CONFIG_DIR) \
            -I$(PKGDIRBASE)/virtwip/src/include

# Embed the VM image as RIOT blob ("blob/lwip.bin.h", symbols lwip_bin /
# lwip_bin_len); vpath keeps bin/<board> out of the C include path.
BLOBS += lwip.bin
vpath lwip.bin $(BINDIR)/pkg-build/virtwip

PSEUDOMODULES += virtwip_arp
PSEUDOMODULES += virtwip_autoip
PSEUDOMODULES += virtwip_dhcp
PSEUDOMODULES += virtwip_dhcp_auto
PSEUDOMODULES += virtwip_ethernet
PSEUDOMODULES += virtwip_igmp
PSEUDOMODULES += virtwip_ipv6_autoconfig
PSEUDOMODULES += virtwip_ipv6_mld
PSEUDOMODULES += virtwip_raw
PSEUDOMODULES += virtwip_sixlowpan
PSEUDOMODULES += virtwip_stats
PSEUDOMODULES += virtwip_tcp
PSEUDOMODULES += virtwip_udp
PSEUDOMODULES += virtwip_udplite
PSEUDOMODULES += virtwip_sock_async
PSEUDOMODULES += virtwip_layout_check

CFLAGS += -DFEMTO_CONTAINER_USER_HELPER

# Maximum VM call depth (saved frames per flow, ~48 B each). A guess for the
# prototype: raise it if executions fail with FC_CALL_DEPTH_LIMIT.
FEMTO_CONTAINER_CALL_DEPTH ?= 32
CFLAGS += -DFEMTO_CONTAINER_CALL_DEPTH=$(FEMTO_CONTAINER_CALL_DEPTH)

# IPV6_FRAG_COPYHEADER and LWIP_SO_RCVTIMEO come from virtwip_config.h

ifneq (,$(filter virtwip_contrib,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib
endif
ifneq (,$(filter virtwip_netdev,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/netdev
endif
ifneq (,$(filter virtwip_netif_init_devs,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/init_devs
endif
ifneq (,$(filter virtwip_sock,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock
endif
ifneq (,$(filter virtwip_sock_async,$(USEMODULE)))
  CFLAGS += -DSOCK_HAS_ASYNC
endif
ifneq (,$(filter virtwip_sock_ip,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock/ip
endif
ifneq (,$(filter virtwip_sock_tcp,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock/tcp
endif
ifneq (,$(filter virtwip_sock_udp,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock/udp
endif
