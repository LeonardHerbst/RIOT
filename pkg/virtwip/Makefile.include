INCLUDES += -I$(RIOTBASE)/pkg/virtwip/include \
            -I$(PKGDIRBASE)/virtwip/src/include

PSEUDOMODULES += virtwip_arp
PSEUDOMODULES += virtwip_autoip
PSEUDOMODULES += virtwip_dhcp
PSEUDOMODULES += virtwip_dhcp_auto
PSEUDOMODULES += virtwip_ethernet
PSEUDOMODULES += virtwip_igmp
PSEUDOMODULES += virtwip_ipv6_autoconfig
PSEUDOMODULES += virtwip_ipv6_mld
PSEUDOMODULES += virtwip_raw
PSEUDOMODULES += virtwip_sixlowpan
PSEUDOMODULES += virtwip_stats
PSEUDOMODULES += virtwip_tcp
PSEUDOMODULES += virtwip_udp
PSEUDOMODULES += virtwip_udplite
PSEUDOMODULES += virtwip_sock_async

CFLAGS += -DFEMTO_CONTAINER_USER_HELPER

ifneq (,$(filter arch_64bit,$(FEATURES_USED)))
# Required for platforms where sizeof(void*) > 4
    CFLAGS += -DIPV6_FRAG_COPYHEADER=1
endif

ifneq (,$(filter virtwip_sock_%,$(USEMODULE)))
  CFLAGS += -DLWIP_SO_RCVTIMEO
endif

ifneq (,$(filter virtwip_contrib,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib
endif
ifneq (,$(filter virtwip_netdev,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/netdev
endif
ifneq (,$(filter virtwip_netif_init_devs,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/init_devs
endif
ifneq (,$(filter virtwip_sock,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock
endif
ifneq (,$(filter virtwip_sock_async,$(USEMODULE)))
  CFLAGS += -DSOCK_HAS_ASYNC
endif
ifneq (,$(filter virtwip_sock_ip,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock/ip
endif
ifneq (,$(filter virtwip_sock_tcp,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock/tcp
endif
ifneq (,$(filter virtwip_sock_udp,$(USEMODULE)))
  DIRS += $(RIOTBASE)/pkg/virtwip/contrib/sock/udp
endif
